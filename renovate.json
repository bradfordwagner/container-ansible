{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bradfordwagner/renovate:container-image",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Cap python at the highest minor the current ansible major supports; ansible-python.mjs keeps this in sync",
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.16"
    },
    {
      "description": "Keep requires-python, .python-version and the python cap in sync with the ansible major (.github/renovate/compat.json)",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "ansible"
      ],
      "postUpgradeTasks": {
        "commands": [
          "node .github/renovate/ansible-python.mjs {{{newVersion}}}"
        ],
        "fileFilters": [
          "pyproject.toml",
          "uv.lock",
          ".python-version",
          "renovate.json"
        ],
        "executionMode": "update"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv release pinned as uv_version in install_ansible.sh",
      "managerFilePatterns": [
        "/^install_ansible\\.sh$/"
      ],
      "matchStrings": [
        "uv_version=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    }
  ]
}
